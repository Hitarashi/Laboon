{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Hitarashi/Laboon/main/docs/visual-theme.schema.json",
  "title": "Laboon visual theme contract 1",
  "$defs": {
    "iconSlot": {
      "enum": [
        "navigation.home",
        "navigation.search",
        "navigation.library",
        "playback.play",
        "playback.pause",
        "playback.skip",
        "playback.previous",
        "playback.shuffle",
        "playback.repeat",
        "playback.repeatOne",
        "playback.queue",
        "playback.lyrics",
        "playback.waveform",
        "media.artwork",
        "action.more",
        "action.chevron",
        "action.chevronDouble",
        "action.close",
        "action.check",
        "action.download",
        "action.share",
        "action.openLink",
        "action.history",
        "action.info",
        "action.visibility",
        "action.visibilityOff",
        "action.send",
        "action.add",
        "action.remove",
        "action.translate",
        "action.stepMinus",
        "action.stepPlus",
        "action.refresh",
        "queue.playNext",
        "queue.add",
        "queue.moveEarlier",
        "queue.moveLater",
        "queue.promote",
        "queue.remove",
        "settings.appearance",
        "settings.audioProcessing",
        "settings.lyrics",
        "settings.storage",
        "settings.about",
        "settings.services",
        "permission.notifications",
        "permission.storage",
        "permission.bluetoothConnect",
        "permission.bluetoothScan",
        "permission.battery",
        "permission.network",
        "permission.vibration",
        "permission.install",
        "permission.granted",
        "device.monitor",
        "device.car",
        "device.usbAudio",
        "device.bluetoothSpeaker",
        "device.speaker",
        "device.earbuds",
        "device.headphones",
        "device.other",
        "pipeline.decoder",
        "pipeline.engine",
        "pipeline.resampler",
        "rip.archive",
        "rip.decrypt",
        "rip.flash",
        "rip.hourglass",
        "rip.link",
        "rip.resolving",
        "rip.tag",
        "codec.highResolution",
        "codec.lossless",
        "codec.surround",
        "account.profile"
      ]
    },
    "materialSymbol": {
      "enum": [
        "home",
        "search",
        "library_music",
        "play_arrow",
        "pause",
        "skip_next",
        "skip_previous",
        "shuffle",
        "repeat",
        "repeat_one",
        "more_vert",
        "expand_more",
        "expand_less",
        "chevron_left",
        "chevron_right",
        "close",
        "check",
        "cloud_download",
        "share",
        "open_in_new",
        "history",
        "info",
        "visibility",
        "visibility_off",
        "lyrics",
        "queue_music",
        "graphic_eq",
        "add",
        "remove",
        "translate",
        "send",
        "palette",
        "tune",
        "hard_drive",
        "description",
        "notifications",
        "folder_open",
        "bluetooth_connected",
        "bluetooth_searching",
        "battery_saver",
        "wifi",
        "vibration",
        "check_circle",
        "headphones",
        "earbuds",
        "speaker",
        "bluetooth_audio",
        "usb",
        "directions_car",
        "monitor",
        "equalizer",
        "music_note",
        "album",
        "person",
        "settings",
        "audio_file",
        "timer",
        "high_res",
        "surround_sound",
        "network_cell",
        "download",
        "playlist_play",
        "playlist_add",
        "manage_search",
        "mic",
        "volume_up",
        "language",
        "refresh",
        "delete",
        "bookmark",
        "favorite",
        "queue_play_next",
        "play_circle",
        "pause_circle",
        "stop_circle",
        "arrow_back",
        "arrow_forward",
        "arrow_back_ios_new",
        "logout",
        "auto_awesome",
        "music_off",
        "sort",
        "filter_list",
        "search_off",
        "library_books",
        "menu",
        "launch",
        "edit",
        "library_add",
        "battery_charging_full",
        "notifications_active",
        "storage",
        "signal_cellular_alt",
        "touch_app",
        "system_update_alt",
        "settings_suggest",
        "link",
        "bolt",
        "schedule",
        "history_toggle_off",
        "speed",
        "compare_arrows",
        "local_library",
        "person_search",
        "devices",
        "other_houses",
        "archive",
        "lock_open",
        "flash_on",
        "hourglass_top",
        "sell",
        "keyboard_double_arrow_down",
        "keyboard_arrow_up",
        "keyboard_arrow_down",
        "star",
        "install_mobile",
        "file_download",
        "sync",
        "arrow_upward",
        "arrow_downward",
        "fast_forward",
        "library_add_check",
        "track_changes"
      ]
    },
    "assetPath": {
      "type": "string",
      "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$"
    },
    "manifest": {
      "type": "object",
      "required": [
        "id",
        "name",
        "author",
        "version",
        "contractVersion",
        "minimumAndroidApi",
        "definitionAsset"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{2,127}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "author": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "contractVersion": {
          "const": 1
        },
        "minimumAndroidApi": {
          "type": "integer",
          "minimum": 29
        },
        "definitionAsset": {
          "$ref": "#/$defs/assetPath"
        }
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "box",
            "column",
            "row",
            "overlay",
            "scroll",
            "horizontalScroll",
            "lazyColumn",
            "lazyRow",
            "lazyGrid",
            "spacer",
            "text",
            "textField",
            "metadata",
            "icon",
            "artwork",
            "image",
            "button",
            "iconButton",
            "control",
            "surface",
            "progress",
            "drawing",
            "flowRow",
            "hostControl",
            "backdrop"
          ]
        },
        "attributes": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "maxLength": 1024
          },
          "properties": {
            "asset": {
              "$ref": "#/$defs/assetPath"
            },
            "symbol": {
              "$ref": "#/$defs/materialSymbol",
              "description": "Material Symbols Rounded name from the bundled public catalog."
            },
            "slot": {
              "$ref": "#/$defs/iconSlot",
              "description": "Optional Laboon semantic slot that an installed theme can override."
            },
            "filled": {
              "enum": [
                "true",
                "false"
              ]
            },
            "visibleBinding": {
              "type": "string",
              "description": "Render the node only while this presentation binding is true."
            },
            "action": {
              "enum": [
                "back",
                "continue",
                "openTelegram",
                "connectLastFm",
                "connectListenBrainz",
                "requestPermission",
                "openSettings",
                "openSettingsCategory",
                "openHome",
                "openSearch",
                "openLibrary",
                "playPause",
                "openPlayer",
                "playTrack",
                "playNext",
                "addToQueue",
                "openAlbum",
                "openArtist",
                "ripTrack",
                "toggleShuffle",
                "cycleRepeat",
                "previousTrack",
                "nextTrack",
                "seek",
                "openQueue",
                "openLyrics",
                "openAudioInfo",
                "openLyricsShare",
                "toggleLyricLine",
                "setLyricsShareOption",
                "copyLyrics",
                "shareLyrics",
                "refresh",
                "retry",
                "dismissPlayer",
                "openThemePicker",
                "previewTheme",
                "applyTheme",
                "restoreDefault",
                "signOut",
                "selectAudioQuality",
                "search",
                "openVisualizer",
                "cancelRipTask",
                "playQueueEntry",
                "removeQueueEntry",
                "moveQueueEntry",
                "clearQueue",
                "promoteAutoplay",
                "retryDiscovery",
                "openProjectLink",
                "openContributorProfile",
                "copyBuildInfo"
              ]
            },
            "gestureAction": {
              "enum": [
                "back",
                "continue",
                "openTelegram",
                "connectLastFm",
                "connectListenBrainz",
                "requestPermission",
                "openSettings",
                "openSettingsCategory",
                "openHome",
                "openSearch",
                "openLibrary",
                "playPause",
                "openPlayer",
                "playTrack",
                "playNext",
                "addToQueue",
                "openAlbum",
                "openArtist",
                "ripTrack",
                "toggleShuffle",
                "cycleRepeat",
                "previousTrack",
                "nextTrack",
                "seek",
                "openQueue",
                "openLyrics",
                "openAudioInfo",
                "openLyricsShare",
                "toggleLyricLine",
                "setLyricsShareOption",
                "copyLyrics",
                "shareLyrics",
                "refresh",
                "retry",
                "dismissPlayer",
                "openThemePicker",
                "previewTheme",
                "applyTheme",
                "restoreDefault",
                "signOut",
                "selectAudioQuality",
                "search",
                "openVisualizer",
                "cancelRipTask",
                "playQueueEntry",
                "removeQueueEntry",
                "moveQueueEntry",
                "clearQueue",
                "promoteAutoplay",
                "retryDiscovery",
                "openProjectLink",
                "openContributorProfile",
                "copyBuildInfo"
              ]
            }
          }
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      },
      "additionalProperties": false
    },
    "option": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "id",
            "title",
            "type",
            "defaultValue"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "description": {
              "type": "string",
              "maxLength": 1024
            },
            "type": {
              "const": "switch"
            },
            "defaultValue": {
              "enum": [
                "true",
                "false"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "id",
            "title",
            "type",
            "defaultValue",
            "choices"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "description": {
              "type": "string",
              "maxLength": 1024
            },
            "type": {
              "const": "choice"
            },
            "defaultValue": {
              "type": "string"
            },
            "choices": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "type": "string",
                "maxLength": 1024
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "id",
            "title",
            "type",
            "defaultValue",
            "minimum",
            "maximum"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "description": {
              "type": "string",
              "maxLength": 1024
            },
            "type": {
              "const": "slider"
            },
            "defaultValue": {
              "type": "string",
              "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
            },
            "minimum": {
              "type": "number"
            },
            "maximum": {
              "type": "number"
            },
            "step": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "keyframeAnimation": {
      "type": "object",
      "required": [
        "durationMs",
        "frames"
      ],
      "properties": {
        "durationMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "frames": {
          "type": "array",
          "minItems": 2,
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": [
              "fraction",
              "progress"
            ],
            "properties": {
              "fraction": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "progress": {
                "type": "number",
                "minimum": -1,
                "maximum": 2
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": [
    "schemaVersion"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "iconOverrides": {
      "type": "object",
      "maxProperties": 128,
      "propertyNames": {
        "$ref": "#/$defs/iconSlot"
      },
      "additionalProperties": {
        "$ref": "#/$defs/materialSymbol"
      }
    },
    "lightColors": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$"
      }
    },
    "darkColors": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$"
      }
    },
    "shapeDp": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 128
      }
    },
    "typography": {
      "type": "object",
      "maxProperties": 64,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "fontAsset": {
            "$ref": "#/$defs/assetPath"
          },
          "sizeSp": {
            "type": "number",
            "minimum": 8,
            "maximum": 96
          },
          "weight": {
            "type": "integer",
            "minimum": 100,
            "maximum": 900
          },
          "letterSpacingSp": {
            "type": "number",
            "minimum": -2,
            "maximum": 12
          }
        },
        "additionalProperties": false
      }
    },
    "motion": {
      "type": "object",
      "properties": {
        "durationScale": {
          "type": "number",
          "minimum": 0,
          "maximum": 3
        },
        "springDampingRatio": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 2
        },
        "springStiffness": {
          "type": "number",
          "minimum": 50,
          "maximum": 2000
        },
        "keyframes": {
          "type": "object",
          "maxProperties": 32,
          "additionalProperties": {
            "$ref": "#/$defs/keyframeAnimation"
          }
        }
      },
      "additionalProperties": false
    },
    "effects": {
      "type": "object",
      "maxProperties": 16,
      "additionalProperties": {
        "type": "object",
        "required": [
          "shaderAsset"
        ],
        "properties": {
          "shaderAsset": {
            "$ref": "#/$defs/assetPath"
          },
          "uniforms": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "screens": {
      "type": "object",
      "maxProperties": 64,
      "additionalProperties": {
        "$ref": "#/$defs/node"
      }
    },
    "options": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/option"
      }
    },
    "colorSource": {
      "enum": [
        "system",
        "artwork"
      ]
    }
  },
  "additionalProperties": false
}
